generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses   Course[]
  enrollments Enrollment[]
  progress Progress[]
  evidenceSubmissions EvidenceSubmission[]
  notifications Notification[]
  certificates Certificate[]
  payments Payment[]
  comments Comment[]
  reviews  Review[]
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique // ADMIN, INSTRUCTOR, STUDENT
  permissions Permission[]
  users       User[]
}

model Permission {
  id    Int    @id @default(autoincrement())
  name  String @unique
  roles Role[]
}

model Category {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  courses Course[]
}

model Course {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  imageUrl    String?
  thumbnailUrl String?
  videoUrl    String?
  level       String   // BEGINNER, INTERMEDIATE, ADVANCED
  price       Decimal  @db.Decimal(10, 2)
  status      String   // DRAFT, PUBLISHED, ARCHIVED
  instructorId Int
  instructor   User    @relation(fields: [instructorId], references: [id])
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules     Module[]
  enrollments Enrollment[]
  reviews     Review[]
}

model Module {
  id          Int      @id @default(autoincrement())
  title       String
  order       Int
  courseId    Int
  course      Course   @relation(fields: [courseId], references: [id])
  lessons     Lesson[]
}

model Lesson {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  order       Int
  moduleId    Int
  module      Module   @relation(fields: [moduleId], references: [id])
  isFree      Boolean  @default(false)
  requiresEvidence Boolean @default(false)

  video       Video?
  resources   Resource[]
  evidenceSubmissions EvidenceSubmission[]
  progress Progress[]
  comments    Comment[]
}

model Video {
  id        Int    @id @default(autoincrement())
  url       String
  duration  Int?   // in seconds
  lessonId  Int    @unique
  lesson    Lesson @relation(fields: [lessonId], references: [id])
}

model Resource {
  id        Int    @id @default(autoincrement())
  name      String
  url       String
  type      String // PDF, ZIP, CODE, etc.
  lessonId  Int
  lesson    Lesson @relation(fields: [lessonId], references: [id])
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   User     @relation(fields: [studentId], references: [id])
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id])
  status    String   // ACTIVE, COMPLETED, CANCELLED
  courseProgress Float @default(0)
  createdAt DateTime @default(now())
}

model Progress {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     User     @relation(fields: [studentId], references: [id])
  lessonId    Int
  lesson      Lesson   @relation(fields: [lessonId], references: [id])
  percentage  Float    @default(0)
  isCompleted Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model Certificate {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  studentId   Int
  student     User     @relation(fields: [studentId], references: [id])
  courseId    Int
  url         String
  issuedAt    DateTime @default(now())
}

model Payment {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     User     @relation(fields: [studentId], references: [id])
  courseId    Int
  amount      Decimal  @db.Decimal(10, 2)
  method      String   // MANUAL, PAYPAL, STRIPE, etc.
  status      String   // PENDING, APPROVED, REJECTED
  proofUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EvidenceSubmission {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     User     @relation(fields: [studentId], references: [id])
  lessonId    Int
  lesson      Lesson   @relation(fields: [lessonId], references: [id])
  url         String
  status      String   // PENDING, APPROVED, REJECTED
  feedback    String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  lessonId  Int
  userId    Int
  parentId  Int?
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId, createdAt])
  @@index([parentId])
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?  @db.Text
  studentId Int
  student   User     @relation(fields: [studentId], references: [id])
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, courseId])
}
